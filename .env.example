# Server
NODE_ENV=development
PORT=4000
# localhost:3000/3001 are always allowed (see STATIC_DEV_ORIGINS in src/app.ts) — this is
# for deployed frontend origin(s) only, comma-separated
CORS_ORIGIN=https://your-frontend.vercel.app

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ctgbites

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Resend — requires a verified domain (resend.com/domains) before it can email anyone
# other than the account's own address. Lowest-priority fallback below.
RESEND_API_KEY=
EMAIL_FROM="CTG Bites <orders@ctgbites.com>"
EMAIL_ORDER_STATUS_UPDATES=false
EMAIL_ON_ADD_TO_CART=false

# Brevo — the primary sender. HTTPS API (not SMTP), so it works on hosts like Render
# that block outbound SMTP. Only needs one verified sender address (Brevo dashboard ->
# Senders -> click the confirmation link emailed to that address), not a full domain.
# Takes priority over both Gmail and Resend when configured.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="CTG Bites"

# Gmail SMTP — only works where outbound SMTP is allowed (local dev; blocked on
# Render's free tier). Secondary fallback behind Brevo. GMAIL_APP_PASSWORD is a
# 16-character App Password (Google Account > Security > 2-Step Verification > App
# Passwords) — requires 2FA enabled on the account; a normal Gmail password won't work.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public frontend URL — used to build links inside emails (e.g. newsletter unsubscribe)
PUBLIC_SITE_URL=https://ctg-bites.vercel.app

# Cloudinary — if sharing one Cloudinary account across multiple projects,
# CLOUDINARY_FOLDER namespaces this project's uploads under their own folder
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ctg-bites

# bKash (leave blank/commented until sandbox credentials supplied — feature auto-disables)
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Stripe (leave blank/commented until credentials supplied — feature auto-disables)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Seed script — first Owner account
DEFAULT_OWNER_EMAIL=
DEFAULT_OWNER_PASSWORD=
DEFAULT_OWNER_NAME=

# Google Sign-In (customer site) — OAuth 2.0 Client ID from Google Cloud Console
# (Web application type). Leave blank to disable the Google login button/endpoint.
GOOGLE_CLIENT_ID=
